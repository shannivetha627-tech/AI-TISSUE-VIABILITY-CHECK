# Replace this value before deployment.
# Prefer SESSION_SECRET in production; TISSUE_VIABILITY_SECRET_KEY is retained for compatibility.
SESSION_SECRET=change-me
TISSUE_VIABILITY_SECRET_KEY=change-me
SESSION_TIMEOUT=1800
SESSION_COOKIE_SECURE=0
FACE_MATCH_THRESHOLD=0.16
DOCTOR_LOGIN_MAX_FAILURES=5
DOCTOR_LOGIN_COOLDOWN=300

# Production deployment requires HTTPS; set SESSION_COOKIE_SECURE=1.